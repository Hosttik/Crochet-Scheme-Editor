--- /dev/null
+++ b/src/editor/selectionTransform.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest'
+import type { StitchElement } from '../types'
+import {
+  atomicChainGroupSelection,
+  rotateSelectionAroundPivot,
+  scaleSelectionAroundPivot,
+} from './selectionTransform'
+
+function chain(id: string, groupId: string, x: number, y = 0): StitchElement {
+  return {
+    id,
+    groupId,
+    symbolId: 'chain',
+    x,
+    y,
+    rotation: 0,
+    visible: true,
+    locked: false,
+  }
+}
+
+describe('atomic chain group selection', () => {
+  it('recognizes a complete selected chain preset as one editable object', () => {
+    const elements = [chain('a', 'g', -22), chain('b', 'g', 0), chain('c', 'g', 22)]
+    const selection = atomicChainGroupSelection(elements, ['a', 'b', 'c'])
+    expect(selection).not.toBeNull()
+    expect(selection?.groupId).toBe('g')
+    expect(selection?.pivot.x).toBeCloseTo(0)
+    expect(selection?.pivot.y).toBeCloseTo(0)
+  })
+
+  it('does not treat a partial group as atomic', () => {
+    const elements = [chain('a', 'g', -22), chain('b', 'g', 0), chain('c', 'g', 22)]
+    expect(atomicChainGroupSelection(elements, ['a', 'b'])).toBeNull()
+  })
+
+  it('rotates member positions and glyphs around the shared pivot', () => {
+    const elements = [chain('a', 'g', -22), chain('b', 'g', 0), chain('c', 'g', 22)]
+    const rotated = rotateSelectionAroundPivot(elements, ['a', 'b', 'c'], { x: 0, y: 0 }, 90)
+    expect(rotated[0]?.x).toBeCloseTo(0)
+    expect(rotated[0]?.y).toBeCloseTo(-22)
+    expect(rotated[2]?.x).toBeCloseTo(0)
+    expect(rotated[2]?.y).toBeCloseTo(22)
+    rotated.forEach((element) => expect(element.rotation).toBeCloseTo(90))
+  })
+
+  it('scales both member spacing and glyph geometry around the shared pivot', () => {
+    const elements = [chain('a', 'g', -22), chain('b', 'g', 0), chain('c', 'g', 22)]
+    const scaled = scaleSelectionAroundPivot(elements, ['a', 'b', 'c'], { x: 0, y: 0 }, 1.5)
+    expect(scaled[0]?.x).toBeCloseTo(-33)
+    expect(scaled[2]?.x).toBeCloseTo(33)
+    scaled.forEach((element) => {
+      expect(element.geometry?.scaleX).toBeCloseTo(1.5)
+      expect(element.geometry?.scaleY).toBeCloseTo(1.5)
+    })
+  })
+})
